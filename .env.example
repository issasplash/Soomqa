# Copy to .env and fill in. None of these are strictly required for the MVP —
# the public exchange / DeFi endpoints work without auth. Add keys here as we
# extend functionality (e.g. Telegram alerts in a later phase).

# Telegram notifier (Phase 2)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Etherscan V2 (only used if/when on-chain wallet tracking lands)
# ETHERSCAN_API_KEY=
